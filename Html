<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>2048 - Juego</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>2048</h1>
            <div class="score-board">
                <div class="score-box">
                    <p class="score-label">Puntuación</p>
                    <p class="score-value" id="score">0</p>
                </div>
                <div class="score-box">
                    <p class="score-label">Mejor</p>
                    <p class="score-value" id="best-score">0</p>
                </div>
            </div>
        </div>

        <div class="instructions">
            <p>🎯 Combina fichas para llegar a <strong>2048</strong></p>
        </div>

        <div class="game-board" id="gameBoard">
            <!-- Las fichas se generarán con JavaScript -->
        </div>

        <div class="buttons-container">
            <button class="control-btn up-btn" id="upBtn" title="Arriba">⬆️</button>
            <div class="left-right-buttons">
                <button class="control-btn left-btn" id="leftBtn" title="Izquierda">⬅️</button>
                <button class="control-btn down-btn" id="downBtn" title="Abajo">⬇️</button>
                <button class="control-btn right-btn" id="rightBtn" title="Derecha">➡️</button>
            </div>
        </div>

        <div class="action-buttons">
            <button class="action-btn new-game-btn" id="newGameBtn">🔄 Nuevo Juego</button>
            <button class="action-btn undo-btn" id="undoBtn">↶ Deshacer</button>
        </div>

        <div class="mobile-instructions">
            <p>📱 Desliza tu dedo en cualquier dirección</p>
        </div>
    </div>

    <!-- Modal de Game Over -->
    <div class="modal" id="gameOverModal">
        <div class="modal-content">
            <h2 id="modalTitle">¡Game Over!</h2>
            <p id="modalMessage">Tu puntuación: <span id="modalScore">0</span></p>
            <button class="modal-btn" id="modalBtn">Jugar de Nuevo</button>
        </div>
    </div>

    <script src="game.js"></script>
</body>
</html>
